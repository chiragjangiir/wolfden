<Project Sdk="Microsoft.NET.Sdk">

  <!-- A library, not an executable: 'wolfden serve' hosts it in-process (#23). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wolfden.Api.Tests" />
    <InternalsVisibleTo Include="wolfden" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wolfden.Core\Wolfden.Core.csproj" />
    <ProjectReference Include="..\Wolfden.Index\Wolfden.Index.csproj" />
  </ItemGroup>

  <!-- The den's shared read queries and their results (DenReader). -->
  <ItemGroup>
    <Using Include="Wolfden.Index.Reading" />
    <Using Include="Wolfden.Index.Writing" />
  </ItemGroup>

</Project>
