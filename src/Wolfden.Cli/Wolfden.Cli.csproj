<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>wolfden</AssemblyName>
    <RootNamespace>Wolfden.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wolfden.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wolfden.Core\Wolfden.Core.csproj" />
    <ProjectReference Include="..\Wolfden.Index\Wolfden.Index.csproj" />
    <ProjectReference Include="..\Wolfden.Git\Wolfden.Git.csproj" />
    <ProjectReference Include="..\Wolfden.Api\Wolfden.Api.csproj" />
    <ProjectReference Include="..\Wolfden.Mcp\Wolfden.Mcp.csproj" />
  </ItemGroup>

  <!-- The built web UI (npm run build in web/), served by 'wolfden serve' from
       wwwroot next to the executable. dotnet build doesn't run npm: without a
       built UI, serve still runs the API and says how to build the UI (#23). -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\web\dist\index.html')">
    <None Include="..\..\web\dist\**\*" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
