<Project>

  <!-- Central Package Management: every package version lives here, and
       project files list packages without versions. Check a package's
       license before adding it (see CLAUDE.md). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Core">
    <PackageVersion Include="Markdig" Version="1.4.0" />                       <!-- BSD-2-Clause -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />                   <!-- MIT -->
  </ItemGroup>

  <ItemGroup Label="Index">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />  <!-- MIT; bundles SQLite (public domain) via SQLitePCLRaw (Apache-2.0) -->
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />      <!-- MIT -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />                      <!-- Apache-2.0 -->
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />     <!-- Apache-2.0 -->
  </ItemGroup>

</Project>
